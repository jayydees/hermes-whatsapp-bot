# Variable names only. Put real values in /opt/data/.env on the server or in
# Railway service variables. Never commit real values.

# WhatsApp bridge (read by Hermes and its bridge)
WHATSAPP_ENABLED=
WHATSAPP_MODE=
# Phone numbers or LIDs allowed to trigger the bot. Messages from anyone else
# are dropped by the bridge (unless WHATSAPP_DM_POLICY=pairing).
WHATSAPP_ALLOWED_USERS=
WHATSAPP_GROUP_POLICY=
WHATSAPP_REQUIRE_MENTION=
WHATSAPP_DEBUG=

# Model providers
GEMINI_API_KEY=

# /pmjobtrend (Naukri pages fetched through Firecrawl)
FIRECRAWL_API_KEY=

# /logjobs (Google Sheet target). The service-account key file itself lives at
# /opt/data/secrets/google-sa.json, or at the path in GOOGLE_SA_KEY.
SHEET_ID=
SHEET_TAB=
GOOGLE_SA_KEY=

# /gmeet (path to the OAuth token file written by tools/gmeet-auth.js)
GMEET_TOKEN=

# Optional path overrides used by the scripts (defaults are under /opt/data)
GROUP_LOG_DIR=
JOBS_CSV=
SENT_IDS_PATH=
HERMES_ENV_FILE=
HERMES_CONFIG=
WA_SESSION_DIR=
WA_BRIDGE=
GROUP_NAME_CACHE=
AITRENDS_HOME=
PMJOBS_HOME=
